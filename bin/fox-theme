#!/usr/bin/env bash
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
FOX_DIR="$XDG_CONFIG_HOME/fox-themes"
PALETTES_DIR="$FOX_DIR/palettes"
TEMPLATES_DIR="$FOX_DIR/templates"
GENERATED_DIR="$FOX_DIR/generated"
CURRENT_FILE="$FOX_DIR/current"

get_current_theme() {
  if [ -f "$CURRENT_FILE" ]; then
    cat "$CURRENT_FILE"
  else
    echo "fox-dark"
  fi
}

render_templates_awk() {
  local palette_file="$1"
  local templates_dir="$2"
  local generated_dir="$3"

  mkdir -p "$generated_dir"

  for tmpl in "$templates_dir"/*.tmpl; do
    [ -f "$tmpl" ] || continue
    local out="$generated_dir/$(basename "$tmpl" .tmpl)"

    awk '
            NR == FNR {
                if ($0 ~ /^[[:space:]]*#/ || $0 ~ /^[[:space:]]*$/) next;

                idx = index($0, "=");
                if (idx > 0) {
                    key = substr($0, 1, idx - 1);
                    val = substr($0, idx + 1);

                    gsub(/[ "   \r]/, "", key);
                    gsub(/[ "   \r]/, "", val);

                    if (key != "" && val != "") {
                        nohash = val;
                        sub(/^#/, "", nohash);

                        map["{{ " key " }}"] = val;
                        map["{{ " key "_strip }}"] = nohash;
                    }
                }
                next;
            }

            {
                for (k in map) {
                    gsub(k, map[k]);
                }
                print;
            }
        ' "$palette_file" "$tmpl" >"$out"
  done
}

reload_services() {
  hyprctl reload &>/dev/null || true
}

cmd_set() {
  local theme_name="${1:-}"

  if [ -z "$theme_name" ]; then
    theme_name="$(get_current_theme)"
  fi

  local palette="$PALETTES_DIR/$theme_name.toml"
  if [ ! -f "$palette" ]; then
    echo "Error: Pallete '$theme_name' not found in $PALETTES_DIR"
    exit 1
  fi

  echo "🎨 Applying theme: $theme_name..."
  render_templates_awk "$palette" "$TEMPLATES_DIR" "$GENERATED_DIR"
  echo "$theme_name" >"$CURRENT_FILE"

  local wall_name
  wall_name="$(grep -E '^[[:space:]]*wallpaper[[:space:]]*=' "$palette" | cut -d'=' -f2 | tr -d ' "' || true)"

  if [ -n "$wall_name" ] && command -v fox-wall &>/dev/null; then
    echo "🖼️ Sync wallpaper: $wall_name"
    fox-wall set "$wall_name" || true
  fi

  reload_services
  echo "✨ Theme '$theme_name' applied succesfully."
}

cmd_get() {
  get_current_theme
}

cmd_list() {
  for p in "$PALETTES_DIR"/*.toml; do
    [ -f "$p" ] || continue
    basename "$p" .toml
  done
}

cmd_list_json() {
  local active
  active="$(get_current_theme)"
  local first=true

  printf "["
  for p in "$PALETTES_DIR"/*.toml; do
    [ -f "$p" ] || continue
    local name
    name="$(basename "$p" .toml)"

    if [ "$first" = true ]; then
      first=false
    else
      printf ","
    fi

    local is_active="false"
    [ "$name" = "$active" ] && is_active="true"

    printf '{"name":"%s","active":%s}' "$name" "$is_active"
  done
  printf "]\n"
}

case "${1:-}" in
set)
  cmd_set "${2:-}"
  ;;
get)
  cmd_get
  ;;
list)
  cmd_list
  ;;
list-json)
  cmd_list_json
  ;;
*)
  echo "Usage: fox-theme {set [theme]|get|list|list-json}"
  exit 1
  ;;
esac
